# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (MongoDB) ───────────────────────────────────────
# Local:   mongodb://127.0.0.1:27017/qrmenu
# Railway/Atlas: paste the connection string from the dashboard
MONGODB_URI=mongodb://127.0.0.1:27017/qrmenu

# ── Sessions / Admin login ───────────────────────────────────
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Which restaurant the public site / admin manage by default
DEFAULT_RESTAURANT_SLUG=urbo

# ── Telegram notifications (optional) ────────────────────────
# Leave blank to disable. Can also be set per-restaurant in the DB.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
